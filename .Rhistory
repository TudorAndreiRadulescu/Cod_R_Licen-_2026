write.csv(weights_wide, file.path(output_path, "GMV_Weights_Daily_wide.csv"), row.names = FALSE)
weights_long <- weights_wide |>
tidyr::pivot_longer(-Date, names_to = "Bank", values_to = "Weight") |>
